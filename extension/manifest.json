{
  "manifest_version": 3,
  "name": "CoMind 网页助手",
  "version": "1.0.0",
  "description": "将当前网页题目发送到本机CoMind，生成参考回答。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "CoMind 网页助手",
    "default_popup": "popup.html"
  },
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "发送当前题目到CoMind"
    }
  }
}
